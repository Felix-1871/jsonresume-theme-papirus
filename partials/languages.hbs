{{#if resume.languages.length}}
<section class="section-languages">
	{{>title title='Języki'}}
		{{#each resume.languages}}
		<div class="item">
			{{#if language}}
			<div class="language">
				{{language}}: 
				{{#if fluency}}
				<span class="fluency label label-default">
					   {{fluency}}
				</span>
				{{/if}}
			</div>
			{{/if}}
		</div>
		{{/each}}
</section>
{{/if}}
